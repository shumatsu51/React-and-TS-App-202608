rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyKeys(data, allowedKeys) {
      return data.keys().hasOnly(allowedKeys);
    }

    function hasRequiredKeys(data, requiredKeys) {
      return data.keys().hasAll(requiredKeys);
    }

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isIsoTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isNullableString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function hasCreateTimestamps(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function hasUpdateTimestamp(data) {
      return data.updatedAt == request.time;
    }

    function isValidTrip(data) {
      return hasOnlyKeys(data, [
        'title', 'startDate', 'endDate', 'description', 'budgetAmount', 'createdAt', 'updatedAt'
      ])
        && hasRequiredKeys(data, [
          'title', 'startDate', 'endDate', 'description', 'budgetAmount', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && isIsoDate(data.startDate) && isIsoDate(data.endDate) && data.startDate <= data.endDate
        && isNullableString(data.description, 500)
        && (data.budgetAmount == null || (data.budgetAmount is int
          && data.budgetAmount >= 1 && data.budgetAmount <= 999999999));
    }

    function isValidPlace(data) {
      return hasOnlyKeys(data, ['name', 'isVisited', 'createdAt', 'updatedAt'])
        && hasRequiredKeys(data, ['name', 'isVisited', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.isVisited is bool;
    }

    function tripPath(userId, tripId) {
      return /databases/$(database)/documents/users/$(userId)/trips/$(tripId);
    }

    function placePath(userId, tripId, placeId) {
      return /databases/$(database)/documents/users/$(userId)/trips/$(tripId)/places/$(placeId);
    }

    function tripExists(userId, tripId) {
      return exists(tripPath(userId, tripId));
    }

    function isWithinTripPeriod(userId, tripId, scheduledDate) {
      return isIsoDate(scheduledDate)
        && scheduledDate >= get(tripPath(userId, tripId)).data.startDate
        && scheduledDate <= get(tripPath(userId, tripId)).data.endDate;
    }

    function isValidItineraryItem(userId, tripId, data) {
      return hasOnlyKeys(data, [
        'scheduledDate', 'startTime', 'endTime', 'placeName', 'tripPlaceId', 'memo', 'sortOrder',
        'createdAt', 'updatedAt'
      ])
        && hasRequiredKeys(data, [
          'scheduledDate', 'startTime', 'endTime', 'placeName', 'tripPlaceId', 'memo', 'sortOrder',
          'createdAt', 'updatedAt'
        ])
        && isWithinTripPeriod(userId, tripId, data.scheduledDate)
        && (data.startTime == null || isIsoTime(data.startTime))
        && (data.endTime == null || isIsoTime(data.endTime))
        && (data.startTime == null || data.endTime == null || data.startTime <= data.endTime)
        && data.placeName is string && data.placeName.size() > 0 && data.placeName.size() <= 100
        && (data.tripPlaceId == null || (data.tripPlaceId is string
          && exists(placePath(userId, tripId, data.tripPlaceId))))
        && isNullableString(data.memo, 500)
        && data.sortOrder is int && data.sortOrder >= 0;
    }

    function isValidExpense(data) {
      return hasOnlyKeys(data, [
        'description', 'category', 'amount', 'paymentStatus', 'paidAt', 'memo', 'createdAt', 'updatedAt'
      ])
        && hasRequiredKeys(data, [
          'description', 'category', 'amount', 'paymentStatus', 'paidAt', 'memo', 'createdAt', 'updatedAt'
        ])
        && data.description is string && data.description.size() > 0 && data.description.size() <= 100
        && data.category in ['transport', 'accommodation', 'food', 'activity', 'shopping', 'other']
        && data.amount is int && data.amount >= 1 && data.amount <= 999999999
        && data.paymentStatus in ['unpaid', 'paid']
        && (data.paidAt == null || isIsoDate(data.paidAt))
        && isNullableString(data.memo, 500);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasOnlyKeys(request.resource.data, ['email', 'createdAt', 'updatedAt'])
        && hasRequiredKeys(request.resource.data, ['email', 'createdAt', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && hasCreateTimestamps(request.resource.data);
      allow update: if isOwner(userId)
        && hasOnlyKeys(request.resource.data, ['email', 'createdAt', 'updatedAt'])
        && hasRequiredKeys(request.resource.data, ['email', 'createdAt', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && hasUpdateTimestamp(request.resource.data);
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTrip(request.resource.data)
          && hasCreateTimestamps(request.resource.data);
        allow update: if isOwner(userId) && isValidTrip(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && hasUpdateTimestamp(request.resource.data);
        allow delete: if isOwner(userId);

        match /places/{placeId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && tripExists(userId, tripId)
            && isValidPlace(request.resource.data)
            && hasCreateTimestamps(request.resource.data);
          allow update: if isOwner(userId) && tripExists(userId, tripId)
            && isValidPlace(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && hasUpdateTimestamp(request.resource.data);
          allow delete: if isOwner(userId);
        }

        match /itineraryItems/{itemId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && tripExists(userId, tripId)
            && isValidItineraryItem(userId, tripId, request.resource.data)
            && hasCreateTimestamps(request.resource.data);
          allow update: if isOwner(userId) && tripExists(userId, tripId)
            && isValidItineraryItem(userId, tripId, request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && hasUpdateTimestamp(request.resource.data);
          allow delete: if isOwner(userId);
        }

        match /expenses/{expenseId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && tripExists(userId, tripId)
            && isValidExpense(request.resource.data)
            && hasCreateTimestamps(request.resource.data);
          allow update: if isOwner(userId) && tripExists(userId, tripId)
            && isValidExpense(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && hasUpdateTimestamp(request.resource.data);
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
