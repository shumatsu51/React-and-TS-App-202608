# Firebase Console のプロジェクト設定から値をコピーする。
# これらは Web アプリに埋め込まれる公開設定値であり、秘密情報は置かない。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# local: 既存 Hono + JWT Cookie 認証を使う（Docker Compose の既定値）。
# firebase: Firebase Authentication を使う。旅行データの移行完了前は認証画面だけを確認できる。
VITE_AUTH_PROVIDER=local

# Firebase Emulator Suite を使うローカル開発時だけ true を設定する。
VITE_USE_FIREBASE_EMULATORS=false
